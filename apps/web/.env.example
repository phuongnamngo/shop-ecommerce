# Browser gọi API qua host published port (Sanctum SPA cookie)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookie checklist: mở web và API cùng hostname (localhost HOẶC 127.0.0.1).
# Khớp apps/api: FRONTEND_URL, CORS_ALLOWED_ORIGINS, SANCTUM_STATEFUL_DOMAINS, SESSION_DOMAIN.
# Lệch localhost vs 127.0.0.1 sẽ làm session/CSRF fail.
